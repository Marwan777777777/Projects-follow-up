# Owner connection – migrations and scripts only
DATABASE_URL=postgresql://neondb_owner:PASS@HOST/neondb?sslmode=require

# Runtime connection – app_login role (NOBYPASSRLS). Required in production.
# Create role + password after running: npx tsx src/scripts/migrate-hardening.ts
DATABASE_URL_APP=postgresql://app_login:PASS@HOST/neondb?sslmode=require

AUTH_SECRET=generate-a-random-32-byte-base64-string

STORAGE_DRIVER=dev
# R2 (when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DEV_STORAGE_BASE_URL=http://localhost:3000
